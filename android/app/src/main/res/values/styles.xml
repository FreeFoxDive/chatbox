<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#1C7C54</item>
        <item name="colorPrimaryDark">#145C3E</item>
        <item name="colorAccent">#1C7C54</item>
        <item name="android:statusBarColor">#145C3E</item>
    </style>

    <!-- Capacitor applies this theme to the application at runtime. android:background here is
         inherited by every view, including the WebView paste toolbar, so it must not be the splash. -->
    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
